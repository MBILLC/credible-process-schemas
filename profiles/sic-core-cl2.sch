<schema xmlns="http://purl.oclc.org/dsdl/schematron" xml:lang="en" queryBinding="xslt">
  <title>SIC-CL2</title>
  <ns prefix="srmd" uri="http://ssp-standard.org/SSPTraceability1/SimulationResourceMetaData"/>
  <ns prefix="stc" uri="http://ssp-standard.org/SSPTraceability1/SSPTraceabilityCommon"/>
  <pattern id="SIC-CL2-pattern">
    <rule context="/srmd:SimulationResourceMetaData/stc:Classification[@type='org.mic-core.sic-core']" id="SIC-CL2-context">
      <assert test="stc:ClassificationEntry[@keyword='implementation.model'] or stc:ClassificationEntry[starts-with(@keyword, 'implementation.model.')]" id="SIC-CL2-implementation-model" role="error">CL2 requires the 'implementation.model' SIC Core attribute (promoted from Recommended at this level).</assert>
      <assert test="stc:ClassificationEntry[@keyword='implementation.parameter'] or stc:ClassificationEntry[starts-with(@keyword, 'implementation.parameter.')]" id="SIC-CL2-implementation-parameter" role="error">CL2 requires the 'implementation.parameter' SIC Core attribute (promoted from Recommended at this level).</assert>
      <assert test="stc:ClassificationEntry[@keyword='implementation.test-case'] or stc:ClassificationEntry[starts-with(@keyword, 'implementation.test-case.')]" id="SIC-CL2-implementation-test-case" role="error">CL2 requires the 'implementation.test-case' SIC Core attribute (promoted from Recommended at this level).</assert>
      <assert test="stc:ClassificationEntry[@keyword='implementation.simulation-environment'] or stc:ClassificationEntry[starts-with(@keyword, 'implementation.simulation-environment.')]" id="SIC-CL2-implementation-simulation-environment" role="error">CL2 requires the 'implementation.simulation-environment' SIC Core attribute (promoted from Recommended at this level).</assert>
      <assert test="stc:ClassificationEntry[@keyword='implementation.simulation-integration'] or stc:ClassificationEntry[starts-with(@keyword, 'implementation.simulation-integration.')]" id="SIC-CL2-implementation-simulation-integration" role="error">CL2 requires the 'implementation.simulation-integration' SIC Core attribute (promoted from Recommended at this level).</assert>
      <assert test="stc:ClassificationEntry[@keyword='implementation.simulation-integration.settings']" id="SIC-CL2-implementation-simulation-integration-settings" role="error">CL2 requires the 'implementation.simulation-integration.settings' SIC Core attribute (promoted from Recommended at this level).</assert>
    </rule>
