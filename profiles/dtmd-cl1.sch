<?xml version="1.0" encoding="UTF-8"?>
<!--
  CDP-DTMD-CL1 — Credible Decision Process record (DTMD) conformance profile CL1.
  GENERATED by credible-process-tools (csp generate) from credible-process-schemas 0.2.0: matrices/process-profile-matrix.csv + particle-profile-matrix.csv. Do not edit; edit the matrices and regenerate.
  Companion to the unmodified upstream DTMD.xsd: validate with the XSD first, then profiles/stc-integrity.sch and profiles/credible-process-core.sch, then this file.
  A step listed here is Mandatory at this level; each listed particle must be populated, not merely present (a Resource that is not a placeholder and carries @source or Content, or a ResourceReference). Steps not listed are Optional at this level.

  The decision maker's steps (DefineResultQuality, DecideObjectiveFulfillment) carry a signed life-cycle entry at every level.

  The assigned level: DefineResultQuality/Output must carry a org.credible-process.core Classification with credibility.level = CL1 (the profile is level-specific, so it also pins the value).
-->
<schema xmlns="http://purl.oclc.org/dsdl/schematron" xml:lang="en" queryBinding="xslt">
  <title>CDP-DTMD-CL1</title>
  <ns prefix="dtmd" uri="http://ssp-standard.org/SSPTraceability1/DecisionTaskMetaData"/>
  <ns prefix="stc" uri="http://ssp-standard.org/SSPTraceability1/SSPTraceabilityCommon"/>
  <pattern id="CDP-DTMD-CL1-step-presence">
    <rule id="CDP-DTMD-CL1-root" context="/dtmd:DecisionTaskMetaData">
      <assert id="CDP-DTMD-CL1-GeneralInformation-present" test="//dtmd:GeneralInformation">
        Step 'GeneralInformation' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-AnalyzeDecisionTask-present" test="//dtmd:AnalyzeDecisionTask">
        Step 'AnalyzeDecisionTask' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-DefineSubTasks-present" test="//dtmd:DefineSubTasks">
        Step 'DefineSubTasks' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-DefineResultQuality-present" test="//dtmd:DefineResultQuality">
        Step 'DefineResultQuality' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-PerformSubTasks-present" test="//dtmd:PerformSubTasks">
        Step 'PerformSubTasks' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-EvaluateResults-present" test="//dtmd:EvaluateResults">
        Step 'EvaluateResults' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CDP-DTMD-CL1-DecideObjectiveFulfillment-present" test="//dtmd:DecideObjectiveFulfillment">
        Step 'DecideObjectiveFulfillment' is mandatory at CL1 but absent from this record.
      </assert>
    </rule>
  </pattern>
  <pattern id="CDP-DTMD-CL1-steps">
    <rule id="CDP-DTMD-CL1-GeneralInformation" context="//dtmd:DecisionTaskMetaData//dtmd:GeneralInformation">
      <!-- phase: -; File identity (GUID, name, version) and derivation chain; foundational, not level-dependent. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-GeneralInformation-populated" test="stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference">
        GeneralInformation is mandatory at every level and must carry a populated Resource or ResourceReference directly.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-AnalyzeDecisionTask" context="//dtmd:DecisionTaskMetaData//dtmd:AnalyzeDecisionTask">
      <!-- phase: Analysis; Entry step of the CDP: the decision to be taken and its criticality inputs. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-AnalyzeDecisionTask-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'AnalyzeDecisionTask' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-DefineSubTasks" context="//dtmd:DecisionTaskMetaData//dtmd:DefineSubTasks">
      <!-- phase: Definition; The simulation (and modeling) sub-tasks spawned by the decision; references each STMD/MTMD. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-DefineSubTasks-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'DefineSubTasks' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-DefineResultQuality" context="//dtmd:DecisionTaskMetaData//dtmd:DefineResultQuality">
      <!-- phase: Definition; Assign specific credibilities: the credibility level required of each sub-task (credibility.level). Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-DefineResultQuality-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'DefineResultQuality' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-PerformSubTasks" context="//dtmd:DecisionTaskMetaData//dtmd:PerformSubTasks">
      <!-- phase: Execution; Execution/monitoring of the sub-tasks. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-PerformSubTasks-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'PerformSubTasks' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-EvaluateResults" context="//dtmd:DecisionTaskMetaData//dtmd:EvaluateResults">
      <!-- phase: Evaluation; Evaluation of the sub-task results against the decision-task requirements. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-EvaluateResults-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'EvaluateResults' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-DecideObjectiveFulfillment" context="//dtmd:DecisionTaskMetaData//dtmd:DecideObjectiveFulfillment">
      <!-- phase: Fulfillment; The decision itself, signed by the decision maker. Mandatory at every level (spine of the decision record). -->
      <assert id="CDP-DTMD-CL1-DecideObjectiveFulfillment-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'DecideObjectiveFulfillment' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
  </pattern>
  <pattern id="CDP-DTMD-CL1-level">
    <rule id="CDP-DTMD-CL1-level-assigned" context="//dtmd:DecisionTaskMetaData//dtmd:DefineResultQuality/stc:Output">
      <assert id="CDP-DTMD-CL1-level-assigned-present" test="stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='credibility.level']">
        DefineResultQuality/Output must carry a org.credible-process.core Classification with credibility.level.
      </assert>
      <assert id="CDP-DTMD-CL1-level-assigned-value" test="stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='credibility.level'] = 'CL1'">
        This profile is CDP-DTMD-CL1: the assigned credibility.level must be CL1 (found '<value-of select="stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='credibility.level']"/>').
      </assert>
    </rule>
  </pattern>
  <pattern id="CDP-DTMD-CL1-signed-steps">
    <rule id="CDP-DTMD-CL1-DefineResultQuality-signed" context="//dtmd:DecisionTaskMetaData//dtmd:DefineResultQuality">
      <assert id="CDP-DTMD-CL1-DefineResultQuality-signed-a" test="stc:LifeCycleInformation[stc:Drafted or stc:Defined or stc:Validated or stc:Approved or stc:Archived or stc:Retracted]">
        Step 'DefineResultQuality' must carry a LifeCycleInformation state (signed by the decision maker) at every level, CL1 included.
      </assert>
    </rule>
    <rule id="CDP-DTMD-CL1-DecideObjectiveFulfillment-signed" context="//dtmd:DecisionTaskMetaData//dtmd:DecideObjectiveFulfillment">
      <assert id="CDP-DTMD-CL1-DecideObjectiveFulfillment-signed-a" test="stc:LifeCycleInformation[stc:Drafted or stc:Defined or stc:Validated or stc:Approved or stc:Archived or stc:Retracted]">
        Step 'DecideObjectiveFulfillment' must carry a LifeCycleInformation state (signed by the decision maker) at every level, CL1 included.
      </assert>
    </rule>
  </pattern>
</schema>
