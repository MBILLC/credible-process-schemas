<?xml version="1.0" encoding="UTF-8"?>
<!--
  CMP-MTMD-CL1 — Credible Modeling Process record (MTMD) conformance profile CL1.
  GENERATED by credible-process-tools (csp generate) from credible-process-schemas 0.1.0: matrices/process-profile-matrix.csv + particle-profile-matrix.csv. Do not edit; edit the matrices and regenerate.
  Companion to the unmodified upstream MTMD.xsd: validate with the XSD first, then profiles/stc-integrity.sch and profiles/credible-process-core.sch, then this file.
  A step listed here is Mandatory at this level; each listed particle must be populated, not merely present (a Resource that is not a placeholder and carries @source or Content, or a ResourceReference). Steps not listed are Optional at this level.

  External validation evidence (CMP): for the QA steps (AssureSimulationSetupQuality, DeriveSimulationSetupQualityVerdict, VerifyAnalysis, VerifyDesignSpecification, VerifyRequirements) the Output/Rationale obligation may alternatively be satisfied by attestation — GeneralInformation carries org.credible-process.core model-validation.mode = 'externally-attested' and the step carries a signed Approved or Validated life-cycle entry (signature presence enforced by stc-integrity.sch STC-INT-100; signer role is a cross-document check, see csp roles).
-->
<schema xmlns="http://purl.oclc.org/dsdl/schematron" xml:lang="en" queryBinding="xslt">
  <title>CMP-MTMD-CL1</title>
  <ns prefix="mtmd" uri="http://ssp-standard.org/SSPTraceability1/ModelingTaskMetaData"/>
  <ns prefix="stc" uri="http://ssp-standard.org/SSPTraceability1/SSPTraceabilityCommon"/>
  <pattern id="CMP-MTMD-CL1-step-presence">
    <rule id="CMP-MTMD-CL1-root" context="/mtmd:ModelingTaskMetaData">
      <assert id="CMP-MTMD-CL1-GeneralInformation-present" test="//mtmd:GeneralInformation">
        Step 'GeneralInformation' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CMP-MTMD-CL1-AnalyzeModelingTaskAndObjectives-present" test="//mtmd:AnalyzeModelingTaskAndObjectives">
        Step 'AnalyzeModelingTaskAndObjectives' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CMP-MTMD-CL1-DecideModelingObjectiveFulfillment-present" test="//mtmd:DecideModelingObjectiveFulfillment">
        Step 'DecideModelingObjectiveFulfillment' is mandatory at CL1 but absent from this record.
      </assert>
    </rule>
  </pattern>
  <pattern id="CMP-MTMD-CL1-steps">
    <rule id="CMP-MTMD-CL1-GeneralInformation" context="//mtmd:ModelingTaskMetaData//mtmd:GeneralInformation">
      <!-- phase: -; File identity (GUID, name, version) and derivation chain; foundational, not level-dependent. Mandatory at every level (spine of the record). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL1-GeneralInformation-populated" test="stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference">
        GeneralInformation is mandatory at every level and must carry a populated Resource or ResourceReference directly.
      </assert>
    </rule>
    <rule id="CMP-MTMD-CL1-AnalyzeModelingTaskAndObjectives" context="//mtmd:ModelingTaskMetaData//mtmd:AnalyzeModelingTaskAndObjectives">
      <!-- phase: Analysis; Entry step of the CMP: what the model is for and why. Mandatory at every level (spine of the record). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL1-AnalyzeModelingTaskAndObjectives-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'AnalyzeModelingTaskAndObjectives' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CMP-MTMD-CL1-DecideModelingObjectiveFulfillment" context="//mtmd:ModelingTaskMetaData//mtmd:DecideModelingObjectiveFulfillment">
      <!-- phase: Fulfillment; Signed statement whether the modeling objective was met. Mandatory at every level (spine of the record). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL1-DecideModelingObjectiveFulfillment-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'DecideModelingObjectiveFulfillment' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
  </pattern>
</schema>
