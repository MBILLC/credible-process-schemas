    <rule id="CMP-MTMD-CL4-AssureSimulationSetupQuality" context="//mtmd:ModelingTaskMetaData//mtmd:AssureSimulationSetupQuality">
      <!-- phase: Implementation; Verification of the implemented setup (code/calculation verification, user-error analysis). Mandatory from CL3 (Design Evaluation: formal VandV plan, documented verification, statistical validation). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL4-AssureSimulationSetupQuality-Input-populated" test="stc:Input[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
