  </pattern>
  <pattern id="CMP-MTMD-CL4-validation-mode">
    <rule id="CMP-MTMD-CL4-validation-mode-present" context="//mtmd:ModelingTaskMetaData/mtmd:GeneralInformation">
      <assert id="CMP-MTMD-CL4-validation-mode-present-a" test="stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='model-validation.mode']">
        At CL4 an MTMD's GeneralInformation must state org.credible-process.core model-validation.mode (internal | copied-in | externally-attested).
      </assert>
    </rule>
  </pattern>
