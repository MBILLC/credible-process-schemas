      <assert id="CMP-MTMD-CL4-DecideModelingObjectiveFulfillment-LifeCycleInformation-populated" test="stc:LifeCycleInformation[stc:Drafted or stc:Defined or stc:Validated or stc:Approved or stc:Archived or stc:Retracted]">
