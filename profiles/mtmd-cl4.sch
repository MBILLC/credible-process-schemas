      </assert>
      <assert id="CMP-MTMD-CL4-DeriveSimulationSetupQualityVerdict-Rationale-populated" test="stc:Rationale[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference] or ((//mtmd:ModelingTaskMetaData/mtmd:GeneralInformation/stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='model-validation.mode'] = 'externally-attested') and stc:LifeCycleInformation[stc:Approved or stc:Validated])">
