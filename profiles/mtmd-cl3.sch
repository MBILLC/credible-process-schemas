      <assert id="CMP-MTMD-CL3-validation-mode-present-a" test="stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='model-validation.mode']">
        At CL3 an MTMD's GeneralInformation must state org.credible-process.core model-validation.mode (internal | copied-in | externally-attested).
      </assert>
    </rule>
  </pattern>
