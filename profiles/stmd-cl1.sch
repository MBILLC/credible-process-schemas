<?xml version="1.0" encoding="UTF-8"?>
<!--
  CSP-STMD-CL1 — Credible Simulation Process record (STMD) conformance profile CL1.
  GENERATED by credible-process-tools (csp generate) from credible-process-schemas 0.1.0: matrices/process-profile-matrix.csv + particle-profile-matrix.csv. Do not edit; edit the matrices and regenerate.
  Companion to the unmodified upstream STMD.xsd: validate with the XSD first, then profiles/stc-integrity.sch and profiles/credible-process-core.sch, then this file.
  A step listed here is Mandatory at this level; each listed particle must be populated, not merely present (a Resource that is not a placeholder and carries @source or Content, or a ResourceReference). Steps not listed are Optional at this level.
-->
<schema xmlns="http://purl.oclc.org/dsdl/schematron" xml:lang="en" queryBinding="xslt">
  <title>CSP-STMD-CL1</title>
  <ns prefix="stmd" uri="http://ssp-standard.org/SSPTraceability1/SimulationTaskMetaData"/>
  <ns prefix="stc" uri="http://ssp-standard.org/SSPTraceability1/SSPTraceabilityCommon"/>
  <pattern id="CSP-STMD-CL1-step-presence">
    <rule id="CSP-STMD-CL1-root" context="/stmd:SimulationTaskMetaData">
      <assert id="CSP-STMD-CL1-GeneralInformation-present" test="//stmd:GeneralInformation">
        Step 'GeneralInformation' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CSP-STMD-CL1-AnalyzeSimulationTaskAndObjectives-present" test="//stmd:AnalyzeSimulationTaskAndObjectives">
        Step 'AnalyzeSimulationTaskAndObjectives' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CSP-STMD-CL1-ExecuteSimulation-present" test="//stmd:ExecuteSimulation">
        Step 'ExecuteSimulation' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CSP-STMD-CL1-EvaluateSimulationResults-present" test="//stmd:EvaluateSimulationResults">
        Step 'EvaluateSimulationResults' is mandatory at CL1 but absent from this record.
      </assert>
      <assert id="CSP-STMD-CL1-DecideSimulationObjectiveFulfillment-present" test="//stmd:DecideSimulationObjectiveFulfillment">
        Step 'DecideSimulationObjectiveFulfillment' is mandatory at CL1 but absent from this record.
      </assert>
    </rule>
  </pattern>
  <pattern id="CSP-STMD-CL1-steps">
    <rule id="CSP-STMD-CL1-GeneralInformation" context="//stmd:SimulationTaskMetaData//stmd:GeneralInformation">
      <!-- phase: -; File identity (GUID, name, version) and derivation chain; foundational, not level-dependent. Mandatory at every level (spine of the record). -->
      <assert id="CSP-STMD-CL1-GeneralInformation-populated" test="stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference">
        GeneralInformation is mandatory at every level and must carry a populated Resource or ResourceReference directly.
      </assert>
    </rule>
    <rule id="CSP-STMD-CL1-AnalyzeSimulationTaskAndObjectives" context="//stmd:SimulationTaskMetaData//stmd:AnalyzeSimulationTaskAndObjectives">
      <!-- phase: Analysis; Entry step of the CSP: what was asked and why. Mandatory at every level (spine of the record). -->
      <assert id="CSP-STMD-CL1-AnalyzeSimulationTaskAndObjectives-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'AnalyzeSimulationTaskAndObjectives' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CSP-STMD-CL1-ExecuteSimulation" context="//stmd:SimulationTaskMetaData//stmd:ExecuteSimulation">
      <!-- phase: Execution; What was run, with which inputs and procedure, producing which outputs. Mandatory at every level (spine of the record). -->
      <assert id="CSP-STMD-CL1-ExecuteSimulation-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'ExecuteSimulation' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CSP-STMD-CL1-EvaluateSimulationResults" context="//stmd:SimulationTaskMetaData//stmd:EvaluateSimulationResults">
      <!-- phase: Evaluation; Evaluation of results against the task objectives. Mandatory at every level (spine of the record). -->
      <assert id="CSP-STMD-CL1-EvaluateSimulationResults-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'EvaluateSimulationResults' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
    <rule id="CSP-STMD-CL1-DecideSimulationObjectiveFulfillment" context="//stmd:SimulationTaskMetaData//stmd:DecideSimulationObjectiveFulfillment">
      <!-- phase: Fulfillment; Signed statement whether the simulation objective was met; hand-off to the decision maker. Mandatory at every level (spine of the record). -->
      <assert id="CSP-STMD-CL1-DecideSimulationObjectiveFulfillment-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'DecideSimulationObjectiveFulfillment' is mandatory at CL1 and must carry a populated Output particle.
      </assert>
    </rule>
  </pattern>
</schema>
