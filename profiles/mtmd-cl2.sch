  <pattern id="CMP-MTMD-CL2-steps">
    <rule id="CMP-MTMD-CL2-GeneralInformation" context="//mtmd:ModelingTaskMetaData//mtmd:GeneralInformation">
      <!-- phase: -; File identity (GUID, name, version) and derivation chain; foundational, not level-dependent. Mandatory at every level (spine of the record). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL2-GeneralInformation-populated" test="stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference">
        GeneralInformation is mandatory at every level and must carry a populated Resource or ResourceReference directly.
      </assert>
    </rule>
    <rule id="CMP-MTMD-CL2-AnalyzeModelingTaskAndObjectives" context="//mtmd:ModelingTaskMetaData//mtmd:AnalyzeModelingTaskAndObjectives">
