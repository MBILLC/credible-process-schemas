      <assert id="CMP-MTMD-CL2-AnalyzeModelingTaskAndObjectives-Input-populated" test="stc:Input[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
        Step 'AnalyzeModelingTaskAndObjectives' is mandatory at CL2 and must carry a populated Input particle.
      </assert>
      <assert id="CMP-MTMD-CL2-AnalyzeModelingTaskAndObjectives-Procedure-populated" test="stc:Procedure[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
