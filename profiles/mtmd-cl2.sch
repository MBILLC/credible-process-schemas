      </assert>
      <assert id="CMP-MTMD-CL2-VerifyAnalysis-Output-populated" test="stc:Output[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference] or ((//mtmd:ModelingTaskMetaData/mtmd:GeneralInformation/stc:Classification[@type='org.credible-process.core']/stc:ClassificationEntry[@keyword='model-validation.mode'] = 'externally-attested') and stc:LifeCycleInformation[stc:Approved or stc:Validated])">
        Step 'VerifyAnalysis' is mandatory at CL2 and must carry a populated Output particle. Alternatively, with model-validation.mode = 'externally-attested' on GeneralInformation, a signed Approved or Validated life-cycle entry on this step satisfies the obligation.
      </assert>
    </rule>
