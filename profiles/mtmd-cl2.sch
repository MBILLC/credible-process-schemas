      </assert>
      <assert id="CMP-MTMD-CL2-DefineModelRequirements-present" test="//mtmd:DefineModelRequirements">
        Step 'DefineModelRequirements' is mandatory at CL2 but absent from this record.
      </assert>
      <assert id="CMP-MTMD-CL2-DefineTestCaseRequirements-present" test="//mtmd:DefineTestCaseRequirements">
