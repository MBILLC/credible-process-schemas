    </rule>
    <rule id="CMP-MTMD-CL2-VerifyAnalysis" context="//mtmd:ModelingTaskMetaData//mtmd:VerifyAnalysis">
      <!-- phase: Analysis; QA sub-step: the task/decision analysis is itself checked. Mandatory from CL2 (Quantitative Predictions: a specified accuracy requirement, checked against an implemented model and test case). CL1/CL2 columns inherit the CSP (STMD) obligation of the same-named step; CL3/CL4 as derived for the CMP. -->
      <assert id="CMP-MTMD-CL2-VerifyAnalysis-Input-populated" test="stc:Input[stc:Resource[not(@placeholder='true') and (@source or stc:Content)] or stc:ResourceReference]">
