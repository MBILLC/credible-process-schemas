<?xml version='1.0' encoding='UTF-8'?>
<stmd:SimulationTaskMetaData xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:stc="http://ssp-standard.org/SSPTraceability1/SSPTraceabilityCommon" xmlns:stmd="http://ssp-standard.org/SSPTraceability1/SimulationTaskMetaData" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.0.0" name="ArchitectureLevelRange" GUID="7b67f636-57d7-405b-972e-c23ee7d72337" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-09-03T19:07:52Z" description="Determine the realistic range for an EV early in Design: Architecture and approximate battery sizing.  ">
    <stmd:GeneralInformation>
        <stc:DerivationChain>
            <stc:DerivationChainEntry GUID="257f3ee0-2004-4c56-843d-44a673ff6ada" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-01-24T23:16:31Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="7f6460bc-4689-4fe8-b2bb-29bd925b4f37" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-01-28T23:34:36Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="dd9f6e06-3228-4441-ac27-a23f313de25d" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-05-23T21:25:15Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="8ff426cd-f30d-49db-9e11-8363a91f7115" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-06-18T18:49:25Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="bb8b4010-2dcb-4948-aacb-07b888f01fd3" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-08-19T21:35:52Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="959cfed5-92bf-46b0-b1b6-53dc47f9e28f" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-08-26T19:00:26Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="41d0bdfc-8c4d-4c77-adc5-cbc228511835" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-08-29T12:18:49Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="20d00d18-96cc-4dd5-9b7d-bc43ad2cc4d0" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-08-29T22:16:01Z" author="Fixture Generator" fileversion="1.0"/>
            <stc:DerivationChainEntry GUID="c48d3ea4-2f7d-44b9-af6e-75abb1b2827f" generationTool="orchideo | easySSP (eXXcellent solutions GmbH)" generationDateAndTime="2025-08-29T22:50:23Z" author="Fixture Generator" fileversion="1.0"/>
        </stc:DerivationChain>
        <stc:Resource kind="document" type="application/pdf" source="GNT_WLTC_v1.0.0.pdf" master="" id="d33a6a9c6-e68b-4a89-9448-179f3323aa55" description="Detailed testing procedure for range testing of vehicle, contains all data for testing through simulation"/>
        <stc:Resource kind="specification" type="text/html" master="https://wiki.unece.org/display/trans/WLTP+Technical+Reports" id="dd2b42d26-e3ff-490c-b36d-8e799af2157a" description="Contains latest updates to WLTP testing rules and procedures. External reference only (see @master) -- not co-archived, per the archival restriction on Resource/@source."><stc:Content>WLTP Technical Reports index, UNECE working party on WLTP.</stc:Content></stc:Resource>
        <stc:ResourceReference xlink:href="#id_8c385250-a1b6-4d34-b898-9cd54055b669"/>
        <stc:ResourceReference xlink:href="DecisionTask.dtmd"/>
    </stmd:GeneralInformation>
    <stmd:AnalysisPhase>
        <stmd:AnalyzeSimulationTaskAndObjectives>
            <stc:Input description="Specification for physical testing, contains all data for simulation as well. ">
                <stc:Resource kind="document" type="text/markdown" source="RangeModel.md" id="id_8c385250-a1b6-4d34-b898-9cd54055b669"/>
                <stc:Resource kind="document" type="text/markdown" source="ControllerAndModelInterfaces.md" id="id_071cddc6-c7a7-4970-b7ba-3299cdbd0188"/>
                <stc:Resource kind="document" type="text/markdown" source="ControllerRequirements.md" id="id_b0e6234f-717a-4d07-b385-644d07de5123"/>
            <stc:ResourceReference xlink:href="#d33a6a9c6-e68b-4a89-9448-179f3323aa55"/>
                <stc:ResourceReference xlink:href="#d1d797bb6-77dd-489b-aa73-c4b10b50d3a0"/>
                </stc:Input>
            <stc:Procedure>
                <stc:Resource kind="document" type="text/markdown" source="CompanyStandardRangeSimulation.md" id="d1d797bb6-77dd-489b-aa73-c4b10b50d3a0">
                    <stc:Classification type="org.mic-core.mic-core" description="MIC Core is defining a standard of core attributes (key information on simulation models that enables proper useage in the usecases) that other standards can adopt, extend, refine. Goal is to have a set of aligned attributes, that means&#10;&#10;- we are focussing on meta data for simulation models&#10;- also link to further detailed information which is needed for deeper traceability&#10;&#10;The development of MIC Core was prompted by the Model Identity Card (MIC) and other metadata standards and the realization that certain core attributes should be standardized across the different metadata standards." xlink:type="simple" xlink:href="https://mic-core.github.io/MIC-Core/main/">
                        <stc:ClassificationEntry keyword="administrative-data.model.name" xlink:type="simple" description="Human-readable way of referring to the model. Usually short and clear. Not necessarily unique. To be distinguished from the model identifier and file name." type="text/plain">EV Range Model External Control</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.model.identifier" xlink:type="simple" description="Unique identifier for the model. Possibly only locally unique, within a given IT system. May not be specific to a given release of the model. The syntax and interpretation of the identifier is not standardized and open to the implementer. Can for example be based on a URI, a model path, or a UUID." type="text/x-modelica">EVExample.ElectricRange</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.model.description" xlink:type="simple" description="Human-readable, textual, general overview. Highlights important information about the model. May include some information formalized in other attributes, without expectation of completeness." type="text/markdown">A Standard Early-Design EV Range model., modified to take solar charging during driving into account. Charging efficiency has been estimated for all solar angles via view angles with a validated solar irradiation model and car geometric surface data. 

### Main assumptions:

* All component models except solar panels previously type-validated 
* 5 m^2 of solar panels
*  Type 3783 solar cells from Solaris Inc
* Car geometry from Prototype 17A
* Battery: Type 345a from MyBattery Inc.  
</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.model.supplier" xlink:type="simple" description="The responsible body and, if applicable, organizational unit within the body, that is responsible for supplying the model. Can bedifferent from the owner or the creator of the model. Should be as specific as possible but also durable, avoiding for example specific people names. Relevant personal data protection guidelines should be takend into account. In case of model assembly, responsible of the overall assembly." type="text/plain">MBI LLC</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.model.confidentiality-level" xlink:type="simple" description="Protection level to apply to the model. Does not specify the organizational scope. Does not define what a receiver is allowed todo or is not allowed to do. Values should be &quot;0: public&quot;, &quot;1: internal&quot;, &quot;2: confidential&quot; or &quot;3: strictly confidential&quot;. Additionalprocesses and tools are required to ensure confidentiality." type="text/plain">Company confidential, plus Need-to know Tier 1 suppliers</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.legal-restriction" xlink:type="simple" description="Defines the rules governing the distribution and usage of the simulation model, including licensing, in the form of an open field:royalties to pay, restriction to noncommercial use, right to modify, related legal contract, etc."/>
                        <stc:ClassificationEntry keyword="administrative-data.release" xlink:type="simple" description="Unique identifier, preferably human-readable (i.e. semantically meaningfull), for the release of a particular simulation model.Represents the result of the intentional act of releasing a model at a particular stage to a particular audience (different from themore general notion of version)." type="text/plain">0.81</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.release.date" xlink:type="simple" description="Date, and possibly time and timezone, of the release of a simulation model. Must respect ISO 8601." type="text/plain">January 28th, 2025</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="administrative-data.release.type" xlink:type="simple" description="Relates to the maturity of the model. To be distinguished from a changing status (e.g. outdated). Fixed at the time of the releaseand not changing. Allows the receiver to evaluate the usage limitations of a given release (e.g. a prelease shall not be used forfinal system validation)." type="text/plain">Under development, pre-alpha</stc:ClassificationEntry>
                        <stc:ClassificationEntry keyword="purpose-objectives.model" xlink:type="simple" description="Purpose for which the model has been built/validated. Free textual field for short human-readable description."/>
                        <stc:ClassificationEntry keyword="subject-information.modelled-entity" xlink:type="simple" description="Name or description of the object represented by the simulation model."/>
                        <stc:ClassificationEntry keyword="implementation.modeling-choice" xlink:type="simple" description="Explanation of the modeling choices, assumptions or simplifications made during the implementation of the model. It shouldinclude:1) effects or phenomena covered introduced in general terms, such as vibration of thermal effects, and detailed;2) how they are covered (in an acausal approach, with a look-up table based on experimental data, etc.).3) typical keywords which permit to facilitate information retrieval (e.g. “Causal”, “Acausal”, “Bond graph”, “Transfer function”)."/>
                        <stc:ClassificationEntry keyword="implementation.model.limitations" xlink:type="simple" description="Restrictions on the use of the model. Especially important if these restrictions are not self-evident to a user (e.g. when the modelprovides an incorrect result)."/>
                        <stc:ClassificationEntry keyword="implementation.model.classification" xlink:type="simple" description="Keyword-based classifications of the model in terms, for example, of physics, engineering or implementation. Can refer tostandard or locally standard schemes. It is recommended to refer to a scheme with the reverse domain notation prefix."/>
                        <stc:ClassificationEntry keyword="implementation.software-hardware-environment-requirements" xlink:type="simple" description="Requirements regarding the software and hardware environment of the model, such as specific tool versions required or hardwarerequired to achieve sufficient perfomance."/>
                        <stc:ClassificationEntry keyword="verification-validation.verification-status" xlink:type="simple" description="Indicates whether a given verification procedure has been followed to successfully reach verification criteria. Verification permitsto confirm that a simulation technically works (code without bug, convergence of discretized models, etc.)."/>
                        <stc:ClassificationEntry keyword="verification-validation.validation-status" xlink:type="simple" description="Indicates whether a given validation procedure has been followed to successfully reach validation criteria. Validation permits toconfirm that a simulation fulfills user needs. For example, validation permits to confirm that a simulation is close enough to areference given particular needs."/>
                        <stc:ClassificationEntry keyword="verification-validation.procedure-criteria" xlink:type="simple" description="Steps and methods followed as well as criteria to reach. Verification and validation can be covered together or separately."/>
                        <stc:ClassificationEntry keyword="verification-validation.report" xlink:type="simple" description="Reports describing the results of the verification and validation. Verification and validation can be covered together or separately.Can be summaries, to facilitate communication and distribution. Typically a link to a report."/>
                    </stc:Classification>
                </stc:Resource>
            </stc:Procedure>
            <stc:Output><stc:Resource kind="document" type="text/markdown" id="id_asto_out1"><stc:Content>Task objectives and KPIs: (1) quantify combined WLTP/NEDC range delta from more aggressive regenerative-brake blending vs. the current 'timid' blending strategy, target &gt;=4% combined-cycle improvement; (2) bound thermal-comfort deviation across 4 representative climate zones; (3) characterise controller behaviour for long steep ascent/descent corner cases; (4) quantify the influence of battery aging on range and performance.</stc:Content></stc:Resource></stc:Output>
            <stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_asto_rat1"><stc:Content>Objectives are taken directly from the SRMD's cred-assessment-sim.simulation-task and question-of-interest entries, so the STMD task record and the SRMD credibility assessment stay traceable to the same stated purpose.</stc:Content></stc:Resource></stc:Rationale>
            <stc:LifeCycleInformation><stc:Approved date="2026-06-01T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation>
        </stmd:AnalyzeSimulationTaskAndObjectives>
        <stmd:VerifyAnalysis><stc:Input><stc:ResourceReference xlink:href="#id_asto_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_va_proc1"><stc:Content>Independent read-through of the objectives/KPIs against the WLTP testing procedure (GNT_WLTC_v1.0.0.pdf) and the company standard range-simulation procedure (CompanyStandardRangeSimulation.md), checking each objective is testable and traceable to a specific output KPI.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_va_out1"><stc:Content>Sign-off memo: all 4 objectives are testable, traceable, and consistent with the DecisionTask.dtmd charter; no scope changes requested.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_va_rat1"><stc:Content>Independent verification of the task framing before Requirements work begins catches scope drift early, when it is cheapest to correct.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-08T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:VerifyAnalysis>
        <stc:LifeCycleInformation/>
    </stmd:AnalysisPhase>
    <stmd:RequirementsPhase>
        <stmd:DefineModelRequirements>
            <stc:Input>
                <stc:Resource kind="document" type="text/markdown" source="AutoSARTorqueArbitrationReq.md" id="id_05107056-3d9f-4a79-a9b0-0320603297f3"/>
            <stc:ResourceReference xlink:href="#id_b0e6234f-717a-4d07-b385-644d07de5123"/>
                <stc:ResourceReference xlink:href="#d33a6a9c6-e68b-4a89-9448-179f3323aa55"/>
                <stc:ResourceReference xlink:href="#id_071cddc6-c7a7-4970-b7ba-3299cdbd0188"/>
                <stc:ResourceReference xlink:href="#dd2b42d26-e3ff-490c-b36d-8e799af2157a"/>
                </stc:Input>
            <stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dmr_proc1"><stc:Content>Derived from RangeModel.md, ControllerAndModelInterfaces.md, ControllerRequirements.md, AutoSARTorqueArbitrationReq.md and the WLTP testing procedure (GNT_WLTC_v1.0.0.pdf).</stc:Content></stc:Resource></stc:Procedure>
            <stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dmr_out1"><stc:Content>Model requirements: architecture-level (early-design) fidelity is sufficient -- lumped electrical/mechanical/thermal representation, not detailed component-level fidelity; must run one full WLTP or NEDC cycle in FMI 2.0 co-simulation in under 5 minutes wall-clock; must expose the standardised signal interface (speed_m, brk_cmd, acc_cmd, tau_brake_ref, tau_ref_rear) per ControllerAndModelInterfaces.md.</stc:Content></stc:Resource></stc:Output>
            <stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dmr_rat1"><stc:Content>Architecture-level fidelity matches the InfiniRange Gate 2 stage (preliminary range evaluation), per the SRMD's own cred-assessment-sim.context-of-use entry -- full detailed-development fidelity is explicitly out of scope at this gate.</stc:Content></stc:Resource></stc:Rationale>
            <stc:LifeCycleInformation><stc:Approved date="2026-06-09T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation>
        </stmd:DefineModelRequirements>
        <stmd:DefineParameterRequirements><stc:Input><stc:ResourceReference xlink:href="#id_071cddc6-c7a7-4970-b7ba-3299cdbd0188"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dpr_proc1"><stc:Content>Identified which parameters need supplier-sourced uncertainty bounds for the sensitivity study, per the SRMD's validation.computational-model.model-uncertainty-quantification entry.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dpr_out1"><stc:Content>Parameter requirements: battery SoC_max must be varied across the Standard/DegradedL1/DegradedL2 variants already defined in SystemStructure.ssd; motor P_nom/w_nom must carry the supplier-declared tolerance band; converter_eta held fixed (low sensitivity, per prior model-sensitivity-quantification results).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dpr_rat1"><stc:Content>Uncertainty quantification for 3rd-party component parameters is the model's stated core purpose (SRMD verification-validation classification), so parameter requirements are scoped to the same set the SRMD already tracks.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-10T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineParameterRequirements>
        <stmd:DefineSimulationEnvironmentRequirements><stc:Input><stc:ResourceReference xlink:href="#id_dmr_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dser_proc1"><stc:Content>Derived solver/tool requirements from the company code-verification standard referenced in the SRMD's verification.calculation.numerical-solver-error entry.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dser_out1"><stc:Content>Environment requirements: FMI 2.0 Co-Simulation only (matches all 7 component FMUs); error-controlled adaptive solver with tolerance &lt;=1e-6; single-threaded execution acceptable (no real-time requirement for this offline study).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dser_rat1"><stc:Content>A tolerance of 1e-6 is the company's own documented adequacy bar for this class of lumped-parameter EV powertrain model, already cited as met in the SRMD.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-10T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineSimulationEnvironmentRequirements>
        <stmd:DefineSimulationIntegrationRequirements><stc:Input><stc:ResourceReference xlink:href="#id_071cddc6-c7a7-4970-b7ba-3299cdbd0188"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dsir_proc1"><stc:Content>Reviewed the causal signal interfaces each component FMU exposes against ControllerAndModelInterfaces.md.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dsir_out1"><stc:Content>Integration requirements: DriverCycleType and TorqueArbitration FMUs coupled inside a 'Controllers' subsystem exactly as in SystemStructure.ssd; the subsystem's tau_brake_ref/tau_ref_rear/brk_cmd/acc_cmd outputs drive the top-level ElectricRange_V2-1 FMU's tau_brake_ref2/tau_ref_in inputs; speed_m closes the loop from the range model back to the driver.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dsir_rat1"><stc:Content>Matches the two-level hierarchical structure already implemented in SystemStructure.ssd / EVRangeExampleNEDC.ssd -- this step records the requirement the existing SSD structure satisfies, rather than proposing a new one.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-11T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineSimulationIntegrationRequirements>
        <stmd:DefineTestCaseRequirements><stc:Input><stc:ResourceReference xlink:href="#id_dmr_out1"/><stc:ResourceReference xlink:href="#d33a6a9c6-e68b-4a89-9448-179f3323aa55"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dtcr_proc1"><stc:Content>Derived acceptance test cases from the WLTP class-3b cycle definition (GNT_WLTC_v1.0.0.pdf) and the NEDC comparison cycle already packaged as a second top-level SSD (EVRangeExampleNEDC.ssd).</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dtcr_out1"><stc:Content>3 test cases required, matching the 3 result sets already present under extra/org.ssp-standard.ssp-traceability.stmd/: (1) baseline regen blending, Standard battery; (2) aggressive regen blending ('AgressiveRegeneration' parameter variant), Standard battery; (3) baseline regen blending, DegradedStandardBatteryL2 (worst-case aged battery) as a lower-bound sensitivity check.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dtcr_rat1"><stc:Content>The 3 cases bound the range-gain claim between a best-case (fresh battery, aggressive regen) and a worst-case (aged battery) condition, matching the SRMD's stated battery-aging question of interest.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-12T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineTestCaseRequirements>
        <stmd:DefineQualityAssuranceRequirements><stc:Input><stc:ResourceReference xlink:href="#id_dtcr_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dqar_proc1"><stc:Content>Defined QA gates per the SRMD's verification.user-error-analysis entry (company practice: prescriptive, documented process + regular user training + code and result review of all simulation results).</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dqar_out1"><stc:Content>QA plan: independent verification review at end of Requirements and Design phases (this document's Verify* steps); independent setup and results review before execution and before Gate 2 submission (Assure*/Derive*Verdict steps).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dqar_rat1"><stc:Content>Matches the company's documented user-error-mitigation practice cited in the SRMD, rather than inventing a task-specific QA scheme.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-12T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineQualityAssuranceRequirements>
        <stmd:VerifyRequirements><stc:Input><stc:ResourceReference xlink:href="#id_dmr_out1"/><stc:ResourceReference xlink:href="#id_dpr_out1"/><stc:ResourceReference xlink:href="#id_dser_out1"/><stc:ResourceReference xlink:href="#id_dsir_out1"/><stc:ResourceReference xlink:href="#id_dtcr_out1"/><stc:ResourceReference xlink:href="#id_dqar_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_vr_proc1"><stc:Content>Independent QA cross-check of all Requirements-phase outputs against DecisionTask.dtmd's charter and the SRMD's stated question of interest.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_vr_out1"><stc:Content>Requirements sign-off memo: no open issues; requirements are complete, mutually consistent, and traceable to the charter.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_vr_rat1"><stc:Content>Requirements-phase sign-off gates entry into Design, avoiding rework from a late-discovered requirements gap.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-13T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:VerifyRequirements>
        <stc:LifeCycleInformation/>
    </stmd:RequirementsPhase>
    <stmd:DesignPhase>
        <stmd:DefineModelDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dmr_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dmds_proc1"><stc:Content>Selected components from the MBI LLC supplier-validated component library (all FMI 2.0 Co-Simulation FMUs generated with the Optimica Compiler Toolkit); the range physics model (ElectricRange_V2) is reused unchanged, while the torque-arbitration controller's regen-blending logic is extended with a new parameter variant.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dmds_out1"><stc:Content>Design: EVExample.FMUs.Intermediate.ElectricRange_V2 reused unchanged (matches the SRMD's model-component-fit target level 4 / status level 2); EVExample.FMUs.TorqueArbitration extended with the 'AgressiveRegeneration' easySSP:ParameterContainer variant already present in SystemStructure.ssd.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dmds_rat1"><stc:Content>Reusing already-validated library components for everything except the specific control-strategy change under study minimises the novel-model risk this task's R3 assignment is chiefly concerned with (see DecisionTask.dtmd's DefineResultQuality rationale).</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-16T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineModelDesignSpecification>
        <stmd:DefineParameterDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dpr_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dpds_proc1"><stc:Content>Mapped parameter requirements onto the ssv:ParameterSet / easySSP:ParameterContainer variant mechanism already used in SystemStructure.ssd.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dpds_out1"><stc:Content>Design: 5 battery/controller variant combinations -- 1_ExtendedRange, 2_ExtendedPlusRange, 3_HighPowerExtendedRange, AgressiveRegeneration, DegradedStandardBatteryL1/L2 -- each a named easySSP:ParameterContainer, plus the base Standard-battery/baseline-regen parameter set as the default binding.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dpds_rat1"><stc:Content>Reuses the variant-container pattern already validated in the existing SSP model rather than introducing a parallel parameterisation mechanism.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-16T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineParameterDesignSpecification>
        <stmd:DefineSimulationEnvironmentDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dser_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dsends_proc1"><stc:Content>Pinned the tool/solver combination actually used to generate the packaged FMUs, read from each FMU's own modelDescription.xml.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dsends_out1"><stc:Content>Environment design: Optimica Compiler Toolkit (generationTool recorded identically in all 7 modelDescription.xml files); CVode-class variable-step adaptive solver; relative tolerance 1e-6, matching DefineSimulationEnvironmentRequirements.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dsends_rat1"><stc:Content>Pinning the exact generation tool/date recorded in the FMUs themselves (rather than a generic solver description) is what makes this record archival-usable for re-execution years later.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-17T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineSimulationEnvironmentDesignSpecification>
        <stmd:DefineSimulationIntegrationDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dsir_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dsids_proc1"><stc:Content>Confirmed the concrete SSD wiring against SystemStructure.ssd's ssd:Connections.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dsids_out1"><stc:Content>Design confirmed: 2-level hierarchical SSD -- 'Controllers' subsystem (DriverCycleType + TorqueArbitration FMUs) nested inside the top-level system alongside the ElectricRange_V2-1 FMU; 7 top-level connectors exposed for reuse by both the WLTP (SystemStructure.ssd) and NEDC (EVRangeExampleNEDC.ssd) drive-cycle variants.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dsids_rat1"><stc:Content>Confirms the existing SSD topology satisfies the integration requirement rather than mandating a redesign.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-17T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineSimulationIntegrationDesignSpecification>
        <stmd:DefineTestCaseDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dtcr_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dtcds_proc1"><stc:Content>Mapped each required test case onto a concrete run folder and config.json execution definition.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dtcds_out1"><stc:Content>Design: simulation1/ = baseline regen blending, Standard battery, WLTP cycle; simulation2/ = aggressive regen blending, Standard battery, WLTP cycle; simulation3/ = baseline regen blending, DegradedStandardBatteryL2, WLTP cycle; each with 2 runs (run1 = full-resolution, run2 = downsampled) per the existing simulationN/runN/ layout.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dtcds_rat1"><stc:Content>Matches the run folders already packaged under extra/org.ssp-standard.ssp-traceability.stmd/, so this design specification documents the structure that generated them rather than inventing a new one.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-18T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineTestCaseDesignSpecification>
        <stmd:DefineQualityAssuranceDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dqar_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dqads_proc1"><stc:Content>Turned the QA plan into concrete, checkable criteria.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dqads_out1"><stc:Content>QA checklist: (1) every component FMU's modelDescription.xml declares fmiVersion 2.0 and CoSimulation capability; (2) every ssd:Connection's start/end connector units match; (3) every ssd:Component/@source resolves inside the archive (checked automatically by a reference-resolution tool).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dqads_rat1"><stc:Content>Reuses the project's existing automated Layer-2 URI/reference checker as part of item (3), rather than duplicating a manual equivalent.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-18T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DefineQualityAssuranceDesignSpecification>
        <stmd:VerifyDesignSpecification><stc:Input><stc:ResourceReference xlink:href="#id_dmds_out1"/><stc:ResourceReference xlink:href="#id_dpds_out1"/><stc:ResourceReference xlink:href="#id_dsends_out1"/><stc:ResourceReference xlink:href="#id_dsids_out1"/><stc:ResourceReference xlink:href="#id_dtcds_out1"/><stc:ResourceReference xlink:href="#id_dqads_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_vds_proc1"><stc:Content>Independent design review against the Requirements-phase sign-off memo.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_vds_out1"><stc:Content>Design sign-off memo: no open issues; design is implementable within the reused-component strategy and ready for Implementation.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_vds_rat1"><stc:Content>Design-phase sign-off gates entry into Implementation.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-06-19T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:VerifyDesignSpecification>
        <stc:LifeCycleInformation/>
    </stmd:DesignPhase>
    <stmd:ImplementationPhase>
        <stmd:ImplementModel><stc:Input><stc:ResourceReference xlink:href="#id_dmds_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_im_proc1"><stc:Content>Model implementation itself is delegated to, and recorded within, a dedicated ModelingTaskMetaData (MTMD) record per model, per the DTMD-&gt;STMD-&gt;MTMD separation of concerns -- this step records only the spawn point and completion status.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_im_out1"><stc:Content>Two MTMD records commissioned and completed: extra/org.ssp-standard.ssp-traceability.mtmd/ElectricRange_V2.mtmd (range physics model) and extra/org.ssp-standard.ssp-traceability.mtmd/TorqueControl.mtmd (torque-arbitration controller, including the new AgressiveRegeneration logic).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_im_rat1"><stc:Content>Keeps per-model implementation detail (already documented in each MTMD's own Implementation phase) out of the task-level STMD record, avoiding duplication.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-02T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:ImplementModel>
        <stmd:ImplementParameter><stc:Input><stc:ResourceReference xlink:href="#id_dpds_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_ip_proc1"><stc:Content>Populated resources/Standard Battery Parameters.ssv and resources/Extended Battery Options.ssv, plus the inline ssv:Parameters and easySSP:ParameterContainer variant blocks in SystemStructure.ssd / EVRangeExampleNEDC.ssd.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_ip_out1"><stc:Content>All 5 parameter-set variants committed and present in the packaged SSD files (confirmed by direct inspection of SystemStructure.ssd's ssd:ParameterBindings).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_ip_rat1"><stc:Content>Implementing parameters directly in the SSD/SSV files (rather than a separate parameter document) keeps the archived package self-contained and re-executable.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-03T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:ImplementParameter>
        <stmd:ImplementSimulationEnvironment><stc:Input><stc:ResourceReference xlink:href="#id_dsends_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_ise_proc1"><stc:Content>Confirmed the packaged FMUs match the pinned environment design by reading each modelDescription.xml's generationTool/generationDateAndTime attributes.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_ise_out1"><stc:Content>Environment pinned and confirmed: 7 FMI 2.0 Co-Simulation FMUs (AmbientTemperature_1, Ambient_TrelHum, Driver, WLTPDriver, TorqueControl, ElectricRange_V2, ElectricRange_V2-1), all generationTool="Optimica Compiler Toolkit", generated between 2025-08-17 and 2025-08-28.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_ise_rat1"><stc:Content>Recording the actual generation tool/dates (not just a nominal spec) is what the STMD archival overlay (STMD-ARCH-02) requires for the archive to remain re-executable.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-03T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:ImplementSimulationEnvironment>
        <stmd:ImplementTestCase><stc:Input><stc:ResourceReference xlink:href="#id_dtcds_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_itc_proc1"><stc:Content>Authored the 3 config.json execution definitions.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:ResourceReference xlink:href="#id_74d730f1-3cd4-426e-87ab-442409380fa1"/><stc:ResourceReference xlink:href="#id_64d78a71-70d7-408f-a2f8-1b098fd3a67b"/><stc:ResourceReference xlink:href="#id_157bae72-4bf8-4d9f-b076-1615c07f538e"/></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_itc_rat1"><stc:Content>Implements exactly the 3 test cases fixed in DefineTestCaseDesignSpecification, no more and no fewer.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-04T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:ImplementTestCase>
        <stmd:IntegrateSimulation><stc:Input><stc:ResourceReference xlink:href="#id_dsids_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_is_proc1"><stc:Content>Assembled and XSD-validated the top-level SystemStructure.ssd (WLTP) and EVRangeExampleNEDC.ssd (NEDC) system structures against the SSP 2.0.1 SystemStructureDescription schema.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_is_out1"><stc:Content>2 integrated, schema-valid SSP system structures produced, sharing the same Controllers subsystem and top-level ElectricRange_V2-1 component but each wired to its own drive-cycle FMU (WLTPDriver.fmu vs. Driver.fmu).</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_is_rat1"><stc:Content>Validated against SSP 2.0.1's own schema before proceeding to QA, catching structural errors at the cheapest possible point.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-07T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Simulation Engineer" name="T. Okafor"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:IntegrateSimulation>
        <stmd:AssureSimulationSetupQuality><stc:Input><stc:ResourceReference xlink:href="#id_is_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_assq_proc1"><stc:Content>Ran the QA checklist from DefineQualityAssuranceDesignSpecification against both integrated SSDs.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_assq_out1"><stc:Content>Setup QA memo: 0 defects found -- all 7 component FMUs declare fmiVersion 2.0 and CoSimulation; all ssd:Connection unit pairs match; all Component/@source references resolve inside the archive.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_assq_rat1"><stc:Content>A clean setup-QA pass before execution avoids wasting simulation wall-clock time on a mis-wired model.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-08T09:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:AssureSimulationSetupQuality>
        <stmd:DeriveSimulationSetupQualityVerdict><stc:Input><stc:ResourceReference xlink:href="#id_assq_out1"/></stc:Input><stc:Procedure><stc:Resource kind="document" type="text/markdown" id="id_dssqv_proc1"><stc:Content>QA reviewer verdict based on the setup QA memo.</stc:Content></stc:Resource></stc:Procedure><stc:Output><stc:Resource kind="document" type="text/markdown" id="id_dssqv_out1"><stc:Content>Verdict: setup APPROVED for execution, no conditions.</stc:Content></stc:Resource></stc:Output><stc:Rationale><stc:Resource kind="document" type="text/markdown" id="id_dssqv_rat1"><stc:Content>0 defects in the setup QA memo supports an unconditional approval.</stc:Content></stc:Resource></stc:Rationale><stc:LifeCycleInformation><stc:Approved date="2026-07-08T11:00:00Z"><stc:Responsible organization="MBI LLC - Vehicle Energy Systems CAE" role="Verification and Validation Engineer" name="P. Lindqvist"/><ssc:Signature role="authenticity" type="application/xml"/></stc:Approved></stc:LifeCycleInformation></stmd:DeriveSimulationSetupQualityVerdict>
        <stc:LifeCycleInformation/>
    </stmd:ImplementationPhase>
    <stmd:ExecutionPhase>
        <stmd:ExecuteSimulation>
            <stc:Input>
                <stc:Resource kind="document" type="text/markdown" source="SimulationNotes.md" id="id_e46a9e0e-6f33-479c-8972-963b8c0906db"/>
            </stc:Input>
